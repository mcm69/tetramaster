{
  "name": "tetramaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTML5/TypeScript clone of the Final Fantasy IX Tetra Master card game.",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 8080",
    "build": "tsc --noEmit && vite build",
    "viewport": "npm run build && node tools/viewport.ts",
    "preview": "vite preview --port 8080",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "rules:audit": "node tools/rules-audit.ts",
    "simulate": "node tools/verify.ts 10000",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run coverage && npm run rules:audit && npm run simulate && npm run balance && npm run perf",
    "perf": "node tools/perf.ts",
    "balance": "node tools/balance.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
